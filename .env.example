# Copiar a .env y completar. El .env no se versiona (ver .gitignore).
# DB_PASSWORD es obligatoria: los scripts fallan al arrancar si falta.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_inmobiliary_data

# Facebook Marketplace usa 3301 por defecto si no defines DB_PORT.

# Reintentos de red (page.goto y descarga de imagenes).
# El backoff es exponencial: 2s, 4s, 8s...
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2

# Facebook: si la fuente ya tiene publicaciones, la corrida es incremental.
# FULL_SWEEP=true fuerza el barrido completo por buckets de precio.
FACEBOOK_FULL_SWEEP=false
FACEBOOK_CONSECUTIVE_EXISTING_LIMIT=5

# Ventana de antiguedad del listado (filtro daysSinceListed de Marketplace).
# Recorrer todo el historico de golpe restringe temporalmente la cuenta, asi que
# la primera corrida mira 30 dias y las siguientes solo 7.
# Marketplace solo respeta 1, 7 y 30.
FACEBOOK_FIRST_RUN_DAYS=30
FACEBOOK_INCREMENTAL_DAYS=7
# Pisa las dos de arriba. En 0 se recolecta sin filtro de fecha.
# FACEBOOK_DATE_LISTED_DAYS=30

# Descarta desde el listado los avisos cuya tarjeta declara otra ciudad, sin
# abrirlos. El radio de Marketplace no respeta el limite municipal, asi que sin
# esto se visitan miles de paginas de detalle para despues rechazarlas.
FACEBOOK_SKIP_NON_PASTO_CARDS=true

# Marketplace no corta el scroll cuando se agotan los avisos de la ciudad: sigue
# rellenando con resultados cada vez mas lejanos. Tras esta cantidad de tarjetas
# seguidas de otra ciudad se da por agotado el inventario local y se pasa al
# siguiente listado. En 0 se desactiva el corte.
FACEBOOK_CONSECUTIVE_OUTSIDE_LIMIT=25

# Radio en km alrededor de Pasto. Vacio lo quita del listado.
FACEBOOK_SEARCH_RADIUS=20
